{
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "pc-tools.product-capture/1.0.0"
    },
    "state": {
      "enum": [
        "ready",
        "partialScope",
        "blocked"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "configurationRoot": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "description": "Git commit SHA of the source checkout; null when the source root is not the top level of a Git checkout.",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Uncommitted or untracked changes under the files the extractor reads (<configurationRoot>/config and project-version.properties); null when revision is null."
        },
        "release": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "generationMode": {
          "enum": [
            "classic",
            "apdGenerated",
            "visualizedOnly"
          ]
        }
      },
      "required": [
        "configurationRoot",
        "revision",
        "dirty",
        "release",
        "generationMode"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "minLength": 1
        },
        "availableProductLines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clauseKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "coverageTiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entityClosure": {
          "enum": [
            "composition",
            "seed"
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "product",
        "line",
        "availableProductLines",
        "clauseKinds",
        "coverageTiers",
        "entityClosure",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "declaration": {
          "$ref": "#/$defs/node"
        },
        "offerings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "displayProperties": {
          "type": "array",
