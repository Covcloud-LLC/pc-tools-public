            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceRef"
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "value",
              "sourceRefs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "declaration",
        "offerings",
        "displayProperties"
      ],
      "additionalProperties": false
