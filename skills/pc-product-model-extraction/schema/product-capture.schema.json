  "$id": "urn:pc-tools:schema:product-capture:1.0.0",
  "title": "Native PC product capture",
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
