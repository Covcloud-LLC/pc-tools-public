          },
          "minItems": 1
        },
        "text": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "mandatory",
            "electable",
            "scripted"
          ]
        },
        "excludedChildren": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "referenceStatus": {
          "enum": [
            "captured",
            "external",
            "narrowed"
          ]
        },
        "referenceReason": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "publicId",
                  "verifiedCaseInsensitive",
                  "narrowed"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceRef"
                }
              }
            },
            "required": [
              "target",
              "status",
              "sourceRefs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "attributes",
        "children",
        "sourceRefs"
      ],
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "symbol"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "pointer"
      ],
      "additionalProperties": false
    }
  },
